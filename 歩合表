<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">

<title>エーデル商事株式会社 上村彰</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 10px;
  background: #f5f5f5;
  font-family:    -apple-system,
    BlinkMacSystemFont,
    "Noto Sans JP",
    "Yu Gothic",
    sans-serif;
  color: #111;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  background: white;
  padding: 10px;
}

h1 {
  text-align: center;
  margin: 0 0 12px;
  font-size: clamp(22px, 5vw, 38px);
  font-weight: 800;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 780px;
  border-collapse: collapse;
  table-layout: fixed;
}

th,
td {
  border: 1px solid #777;
  height: 44px;
  padding: 2px 4px;
  font-size: 16px;
}

th {
  background: #dbe7f2;
  text-align: center;
  font-weight: 800;
}

th:nth-child(1) {
  width: 7%;
}

th:nth-child(2) {
  width: 14%;
}

th:nth-child(3) {
  width: 22%;
}

th:nth-child(4) {
  width: 28%;
}

th:nth-child(5) {
  width: 15%;
}

th:nth-child(6) {
  width: 14%;
}

.no {
  text-align: center;
  font-weight: 700;
}

input {
  width: 100%;
  height: 38px;
  border: none;
  outline: none;
  background: transparent;
  padding: 4px;
  font-size: 15px;
  font-family: inherit;
}

td:nth-child(3) input,
td:nth-child(4) input,
td:nth-child(6) input {
  text-align: left;
}

.amount {
  text-align: right;
}

.summary td {
  height: 52px;
  font-weight: 800;
}

.total {
  background: #fff6d7;
}

.commission {
  background: #eef8e9;
}

.summary-label {
  padding-left: 18px;
}

.money {
  text-align: right;
  padding-right: 10px;
  white-space: nowrap;
}

button {
  margin-top: 12px;
  padding: 10px 18px;
  font-size: 15px;
  border: 1px solid #777;
  border-radius: 8px;
  background: white;
}

.button-area {
  text-align: center;
}

.note {
  text-align: center;
  margin-top: 10px;
  font-size: 12px;
  color: #555;
}
</style>
</head>

<body>

<div class="container">

<h1>エーデル商事株式会社 上村彰</h1>

<div class="table-wrap">

<table>

<thead>
<tr>
<th>No.</th>
<th>作業日</th>
<th>施工現場</th>
<th>現場住所</th>
<th>金額</th>
<th>備考</th>
</tr>
</thead>

<tbody id="commissionRows">
</tbody>

<tbody>

<tr>
<td class="total">21</td>
<td class="total summary-label">合計金額</td>
<td class="total"></td>
<td class="total"></td>
<td class="total money" id="totalAmount">¥0</td>
<td class="total"></td>
</tr>

<tr>
<td class="commission">22</td>
<td class="commission summary-label">歩合（2%）</td>
<td class="commission"></td>
<td class="commission"></td>
<td class="commission money" id="commissionAmount">¥0</td>
<td class="commission"></td>
</tr>

</tbody>

</table>

</div>

<div class="button-area">
<button onclick="clearAll()">入力を全てクリア</button>
</div>

<div class="note">
入力内容はこの端末のブラウザに自動保存されます。
</div>

</div>

<script>

const STORAGE_KEY = "edel_shoji_commission_table";

const rows = document.getElementById("commissionRows");

for (let i = 1; i <= 20; i++) {

  const tr = document.createElement("tr");

  tr.innerHTML = `
    <td class="no">${i}</td>

    <td>
      <input
        type="text"
        data-row="${i}"
        data-field="date"
        placeholder=""
      >
    </td>

    <td>
      <input
        type="text"
        data-row="${i}"
        data-field="site"
        placeholder=""
      >
    </td>

    <td>
      <input
        type="text"
        data-row="${i}"
        data-field="address"
        placeholder=""
      >
    </td>

    <td>
      <input
        type="text"
        inputmode="decimal"
        class="amount"
        data-row="${i}"
        data-field="amount"
        placeholder=""
      >
    </td>

    <td>
      <input
        type="text"
        data-row="${i}"
        data-field="note"
        placeholder=""
      >
    </td>
  `;

  rows.appendChild(tr);
}

const inputs = document.querySelectorAll("input");

function numberValue(value) {

  if (!value) {
    return 0;
  }

  const cleaned = String(value)
    .replace(/¥/g, "")
    .replace(/,/g, "")
    .replace(/円/g, "")
    .replace(/\s/g, "");

  const number = Number(cleaned);

  if (Number.isNaN(number)) {
    return 0;
  }

  return number;
}

function yen(value) {

  return "¥" + Math.round(value).toLocaleString("ja-JP");

}

function calculate() {

  let total = 0;

  document.querySelectorAll(".amount").forEach(input => {

    total += numberValue(input.value);

  });

  const commission = total * 0.02;

  document.getElementById("totalAmount").textContent =
    yen(total);

  document.getElementById("commissionAmount").textContent =
    yen(commission);

}

function saveData() {

  const data = {};

  inputs.forEach(input => {

    const row = input.dataset.row;
    const field = input.dataset.field;

    if (!data[row]) {
      data[row] = {};
    }

    data[row][field] = input.value;

  });

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(data)
  );

}

function loadData() {

  const saved =
    localStorage.getItem(STORAGE_KEY);

  if (!saved) {

    calculate();
    return;

  }

  try {

    const data = JSON.parse(saved);

    inputs.forEach(input => {

      const row = input.dataset.row;
      const field = input.dataset.field;

      if (
        data[row] &&
        data[row][field] !== undefined
      ) {

        input.value =
          data[row][field];

      }

    });

  } catch (error) {

    console.log(error);

  }

  calculate();

}

inputs.forEach(input => {

  input.addEventListener("input", function() {

    calculate();
    saveData();

  });

});

function clearAll() {

  const result =
    confirm("入力内容を全てクリアしますか？");

  if (!result) {
    return;
  }

  inputs.forEach(input => {

    input.value = "";

  });

 localStorage.removeItem(STORAGE_KEY);

 calculate();

}

loadData();

</script>

</body>
</html>
